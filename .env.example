# Copia este archivo a .env.local para desarrollar.
# En Vercel, crea las mismas variables en Project Settings → Environment Variables.

# URL pública de la app (sin barra final)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=CentralShop

# WhatsApp Business, solo dígitos con indicativo. Ej: 573001112233
NEXT_PUBLIC_WHATSAPP=573001112233

# Firma de sesión. En producción usa un secreto largo y aleatorio.
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# MySQL (Clever Cloud, PlanetScale, Railway, etc.).
# Si omites DATABASE_URL, la app arranca en modo demostración con catálogo de ejemplo.
# Formato: mysql://usuario:clave@host:3306/nombre_bd
DATABASE_URL=

# Alternativa Clever Cloud, si no usas DATABASE_URL:
# MYSQL_ADDON_URI=
# MYSQL_ADDON_HOST=
# MYSQL_ADDON_PORT=3306
# MYSQL_ADDON_DB=
# MYSQL_ADDON_USER=
# MYSQL_ADDON_PASSWORD=

# true cuando el servidor MySQL exige TLS
DATABASE_SSL=false

# true aprueba tiendas nuevas al crearlas. false las deja en "pendiente".
TIENDA_AUTO_APROBAR=true
